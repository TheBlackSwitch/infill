{
    "devDependencies": {
        "tsup": "^8.5.1",
        "typescript": "^5.7.3"
    },
    "scripts": {
        "build": "npx tsup src/main.ts --format esm,cjs,iife --dts --clean --global-name Infill",
        "demo": "cd ./demo && php -S localhost:8001"
    },
    "name": "@theblackswitch/infill",
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/main.ts",
    "types": "./dist/public_types.d.ts",
    "exports": {
        ".": {
            "types": "./dist/main.d.ts",
            "import": "./dist/main.js",
            "require": "./dist/main.cjs"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/TheBlackSwitch/infill"
    },
    "bugs": {
        "url": "https://github.com/TheBlackSwitch/infill/issues"
    },
    "homepage": "https://theblackswitch.com/libraries/infill",
    "files": [
        "dist"
    ],
    "author": "theblackswitch",
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "markdown",
        "parser",
        "editor",
        "live",
        "in-text"
    ],
    "description": "A live in-text markdown editor powered by YAMP.",
    "dependencies": {
        "@theblackswitch/yamp": "^0.1.0"
    }
}

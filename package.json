{
    "devDependencies": {
        "@types/prismjs": "^1.26.6",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "scripts": {
        "build": "npx tsup src/main.ts --clean",
        "demo": "cd ./demo && php -S localhost:8002"
    },
    "name": "infill",
    "version": "0.0.2",
    "type": "module",
    "main": "./dist/esm/main.js",
    "types": "./dist/node/main.d.ts",
    "exports": {
        ".": {
            "types": "./dist/node/main.d.ts",
            "import": "./dist/esm/main.js",
            "require": "./dist/node/main.cjs"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/TheBlackSwitch/infill"
    },
    "bugs": {
        "url": "https://github.com/TheBlackSwitch/infill/issues"
    },
    "homepage": "https://theblackswitch.com/libraries/infill",
    "files": [
        "dist"
    ],
    "author": "theblackswitch",
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "markdown",
        "parser",
        "editor",
        "live",
        "in-text"
    ],
    "description": "A live in-text markdown editor powered by YAMP.",
    "dependencies": {
        "@theblackswitch/yamp": "^0.2.0",
        "dompurify": "^3.4.14",
        "prismjs": "^1.30.0"
    }
}
